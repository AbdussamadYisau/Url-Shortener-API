{
  "name": "url-shortener",
  "version": "2.0.0",
  "description": "A modern URL shortener with an Express API, MongoDB storage and a responsive web interface",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "node --test",
    "start:demo": "STORAGE=memory node index.js",
    "build": "node scripts/build.mjs",
    "dev:frontend": "node scripts/build.mjs --watch",
    "prestart": "npm run build",
    "predev": "npm run build",
    "prestart:demo": "npm run build",
    "pretest": "npm run build",
    "vercel-build": "npm run build"
  },
