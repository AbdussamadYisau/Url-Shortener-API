PORT=8080
BASE_URL=http://localhost:8080
# For local development only. Links disappear on restart.
STORAGE=memory
# For persistent storage, remove STORAGE=memory and set:
# DB_CONNECTION=mongodb://127.0.0.1:27017/url-shortener
# Set only behind one trusted reverse proxy, such as Vercel:
# TRUST_PROXY=1
# Vercel MongoDB Atlas integration: MONGODB_URI is also supported.

# Google Cloud Console > OAuth client > Web application
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Authorized redirect URI: BASE_URL/api/auth/google/callback
# 0 disables expiry; positive integer expires ALL links after this many days.
LINK_RETENTION_DAYS=0
SESSION_MAX_AGE_DAYS=7
# Random secret, at least 32 characters. Required for scheduled deletion.
CRON_SECRET=
